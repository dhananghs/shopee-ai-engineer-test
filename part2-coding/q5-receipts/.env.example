# Copy this file to .env and put your real key in it.
#   cp .env.example .env
# .env is in .gitignore so it never gets committed.

# --- openrouter ---
# get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-put-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- django ---
DEBUG=1
SECRET_KEY=dev-key-only-for-local-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- database ---
# port 5433 because the postgres container from question 4 is on that port
DB_NAME=receipts
DB_USER=shopee
DB_PASSWORD=shopee
DB_HOST=localhost
DB_PORT=5433

# The receipt photo is normally NOT saved anywhere - it is read once and
# thrown away. Set this to 1 only while checking that the reading works,
# then put it back to 0.
KEEP_RECEIPT_IMAGE=0
